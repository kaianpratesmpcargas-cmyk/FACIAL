# Configuração do Supabase (Opcional - Sistema funciona 100% de imediato em modo integrado)
# Para conectar a um projeto real no Supabase:
# 1. Copie este arquivo para .env
# 2. Preencha os valores abaixo obtidos no painel do Supabase (Project Settings > API)
# 3. Execute o script 'src/supabase/schema.sql' no SQL Editor do Supabase

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
